#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>


/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Zocken";

            bindings = <
                &kp ESC   &kp N1    &kp N2    &kp W     &kp E     &kp N3                                                    &none &none &none &none &none &none
                &kp LSHFT &kp N4    &kp A     &kp S     &kp D     &kp N5                                                    &none &none &none &none &none &none
                &kp N6    &kp N7    &kp N8    &kp C     &kp N9    &kp N0    &mo 1        &kp F5                 &none &none &none &none &none &none &none &none
                                             &kp C_MUTE &kp B     &kp Q     &kp SPACE    &kp F                  &none &none &none &none &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        rgb_layer {
            display-name = "LEDs";

            bindings = <
                &none  &rgb_ug RGB_EFF  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI                         &none &none &none &none &none &none
                &none  &rgb_ug RGB_EFR  &rgb_ug RGB_SPD  &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD                         &none &none &none &none &none &none
                &none  &none            &none            &none            &none            &none &none &studio_unlock  &none &none &none &none &none &none &none &none
                                                                               &none &none &none &none &none           &none &none &none &none &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
    };
};
